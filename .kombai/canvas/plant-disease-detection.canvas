      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n@keyframes indSlide {\n  0% { transform: translateX(-100%); }\n  100% { transform: translateX(285%); }\n}\n</style>\n<div class=\"min-h-screen w-full bg-[#ECEBF1] p-[36px] text-[#191919]\" data-kid=\"1\" data-name=\"app background page container\" style=\"font-family:'Hanken Grotesk',system-ui,-apple-system,sans-serif;\">\n<div class=\"flex items-start gap-[28px]\" data-kid=\"1-1\" data-name=\"screen showcase row container\">\n<!-- 1. Choose a photo -->\n<div class=\"flex w-[375px] shrink-0 flex-col gap-3\" data-kid=\"1-1-1\" data-name=\"choose photo screen column\">\n<div class=\"text-[13px] font-medium leading-5 text-[#191919]/50\" data-kid=\"1-1-1-1\" data-name=\"photograph step label text\">Choose a photo</div>\n<div class=\"flex h-[812px] w-[375px] flex-col gap-4 overflow-hidden rounded-[28px] border border-black/5 bg-[#F5F4F9] p-4 shadow-[0_30px_60px_-30px_rgba(25,25,25,0.30)]\" data-kid=\"1-1-1-2\" data-name=\"phone mockup frame (choose photo screen)\">\n<div class=\"flex h-14 shrink-0 items-center\" data-kid=\"1-1-1-2-1\" data-name=\"app header bar\">\n<span class=\"text-[15px] font-semibold tracking-[-0.01em]\" data-kid=\"1-1-1-2-1-1\" data-name=\"app header title text\">Plant Disease Detection</span>\n</div>\n<div class=\"relative h-[256px] shrink-0 overflow-hidden rounded-[22px] border border-black/5 bg-white\" data-kid=\"1-1-1-2-2\" data-name=\"photo upload drop zone area\">\n<div class=\"absolute inset-3 flex flex-col items-center justify-center gap-3 rounded-[16px] border border-dashed border-[#191919]/20 bg-[#F5F4F9]\" data-kid=\"1-1-1-2-2-1\" data-name=\"dashed upload placeholder container\">\n<span class=\"text-[30px] leading-none text-[#191919]/40\" data-kid=\"1-1-1-2-2-1-1\" data-name=\"camera icon placeholder wrapper\"><i class=\"ti ti-camera\" data-kid=\"1-1-1-2-2-1-1-1\" data-name=\"camera outline icon\"></i></span>\n</div>\n</div>\n<button class=\"flex h-14 w-full shrink-0 items-center justify-center gap-2 rounded-full bg-[#944BBB] text-[17px] font-semibold text-[#F5F4F9]\" data-kid=\"1-1-1-2-3\" data-name=\"choose photo primary button\" type=\"button\">\n<span class=\"text-[22px] leading-none\" data-kid=\"1-1-1-2-3-1\" data-name=\"button icon wrapper\"><i class=\"ti ti-camera\" data-kid=\"1-1-1-2-3-1-1\" data-name=\"camera icon\"></i></span>Choose photo\n        </button>\n<div class=\"mt-auto flex shrink-0 flex-col overflow-hidden rounded-[24px] border border-black/5 bg-white\" data-kid=\"1-1-1-2-4\" data-name=\"photo guidance and supported crops block\">\n<p class=\"px-5 py-4 text-[18px] leading-[26px]\" data-kid=\"1-1-1-2-4-1\" data-name=\"photo guidance tip text\">One leaf, in focus, in daylight.</p>\n<div class=\"flex h-12 shrink-0 items-center justify-between border-t border-black/10 px-5\" data-kid=\"1-1-1-2-5\" data-name=\"supported crops footer row\">\n<span class=\"text-[15px] font-semibold\" data-kid=\"1-1-1-2-5-1\" data-name=\"supported crops link label\">Supported crops</span>\n<span class=\"text-[18px] leading-none text-[#191919]/35\" data-kid=\"1-1-1-2-5-2\" data-name=\"chevron right icon wrapper\"><i class=\"ti ti-chevron-right\" data-kid=\"1-1-1-2-5-2-1\" data-name=\"chevron right arrow icon\"></i></span>\n</div>\n</div>\n</div>\n</div>\n<!-- 2. Analysing -->\n<div class=\"flex w-[375px] shrink-0 flex-col gap-3\" data-kid=\"1-1-2\" data-name=\"analysing screen column\">\n<div class=\"text-[13px] font-medium leading-5 text-[#191919]/50\" data-kid=\"1-1-2-1\" data-name=\"analysing step label text\">Analysing</div>\n<div class=\"flex h-[812px] w-[375px] flex-col gap-4 overflow-hidden rounded-[28px] border border-black/5 bg-[#F5F4F9] p-4 shadow-[0_30px_60px_-30px_rgba(25,25,25,0.30)]\" data-kid=\"1-1-2-2\" data-name=\"phone mockup frame (analysing screen)\">\n<div class=\"flex h-14 shrink-0 items-center\" data-kid=\"1-1-2-2-1\" data-name=\"app header bar\">\n<span class=\"text-[15px] font-semibold tracking-[-0.01em]\" data-kid=\"1-1-2-2-1-1\" data-name=\"app header title text\">Plant Disease Detection</span>\n</div>\n<div class=\"relative h-[256px] shrink-0 overflow-hidden rounded-[22px] border border-black/5 bg-[#DCDCDD]\" data-kid=\"1-1-2-2-2\" data-name=\"uploaded leaf photo container\">\n<img alt=\"Tomato leaf with brown spots (Nothing Ahead on Pexels)\" class=\"h-full w-full object-cover\" data-kid=\"1-1-2-2-2-1\" data-name=\"tomato leaf photo image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/7124505/pexels-photo-7124505.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=800&amp;q=80\"/>\n</div>\n<div class=\"shrink-0 rounded-[24px] border border-black/5 bg-white p-5\" data-kid=\"1-1-2-2-4\" data-name=\"analysing status card\">\n<p class=\"text-[20px] font-semibold leading-7\" data-kid=\"1-1-2-2-4-1\" data-name=\"analysing status headline\">Analysing photo</p>\n<div class=\"mt-4 h-1.5 w-full overflow-hidden rounded-full bg-[#191919]/10\" data-kid=\"1-1-2-2-4-2\" data-name=\"progress track bar\">\n<div class=\"h-full w-[38%] rounded-full bg-[#944BBB]\" data-dynamic=\"true\" data-kid=\"1-1-2-2-4-2-1\" data-name=\"animated indeterminate progress fill\" data-reason=\"transform replaced by infinite indSlide keyframe animation\" style=\"animation: indSlide 1.6s ease-in-out infinite;\"></div>\n</div>\n</div>\n</div>\n</div>\n<!-- 3. Result -->\n<div class=\"flex w-[375px] shrink-0 flex-col gap-3\" data-kid=\"1-1-3\" data-name=\"result screen column\">\n<div class=\"text-[13px] font-medium leading-5 text-[#191919]/50\" data-kid=\"1-1-3-1\" data-name=\"result step label text\">Result</div>\n<div class=\"flex h-[812px] w-[375px] flex-col gap-4 overflow-hidden rounded-[28px] border border-black/5 bg-[#F5F4F9] p-4 shadow-[0_30px_60px_-30px_rgba(25,25,25,0.30)]\" data-kid=\"1-1-3-2\" data-name=\"phone mockup frame (result screen)\">\n<div class=\"flex h-14 shrink-0 items-center\" data-kid=\"1-1-3-2-1\" data-name=\"app header bar\">\n<span class=\"text-[15px] font-semibold tracking-[-0.01em]\" data-kid=\"1-1-3-2-1-1\" data-name=\"app header title text\">Plant Disease Detection</span>\n</div>\n<div class=\"relative h-[256px] shrink-0 overflow-hidden rounded-[22px] border border-black/5 bg-[#DCDCDD]\" data-kid=\"1-1-3-2-2\" data-name=\"uploaded leaf photo container\">\n<img alt=\"Tomato leaf with brown spots (Nothing Ahead on Pexels)\" class=\"h-full w-full object-cover\" data-kid=\"1-1-3-2-2-1\" data-name=\"tomato leaf photo image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/7124505/pexels-photo-7124505.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=800&amp;q=80\"/>\n</div>\n<div class=\"flex h-14 shrink-0 items-center justify-between gap-3\" data-kid=\"1-1-3-2-3\" data-name=\"photo action buttons row\">\n<button class=\"flex h-12 items-center gap-2 text-[15px] font-semibold text-[#191919]/55\" data-kid=\"1-1-3-2-3-1\" data-name=\"enlarge photo button\" type=\"button\">\n<span class=\"text-[20px] leading-none\" data-kid=\"1-1-3-2-3-1-1\" data-name=\"button icon wrapper\"><i class=\"ti ti-zoom-in\" data-kid=\"1-1-3-2-3-1-1-1\" data-name=\"zoom in icon\"></i></span>Enlarge photo\n          </button>\n<button class=\"flex h-12 items-center gap-2 rounded-full border border-[#191919]/15 px-4 text-[15px] font-semibold\" data-kid=\"1-1-3-2-3-2\" data-name=\"replace photo button\" type=\"button\">\n<span class=\"text-[18px] leading-none\" data-kid=\"1-1-3-2-3-2-1\" data-name=\"button icon wrapper\"><i class=\"ti ti-refresh\" data-kid=\"1-1-3-2-3-2-1-1\" data-name=\"refresh icon\"></i></span>Replace photo\n          </button>\n</div>\n<div class=\"flex min-h-0 flex-1 flex-col\" data-kid=\"1-1-3-2-4\" data-name=\"result content wrapper\">\n<div class=\"flex min-h-0 flex-1 flex-col overflow-hidden rounded-[24px] border border-black/5 bg-white p-4\" data-kid=\"1-1-3-2-4-1\" data-name=\"result details card\">\n<div class=\"inline-flex h-7 w-fit items-center gap-1.5 rounded-full bg-[#944BBB] px-2.5 text-[12px] font-semibold text-[#F5F4F9]\" data-kid=\"1-1-3-2-4-1-1\" data-name=\"supported result badge\">\n<span class=\"text-[14px] leading-none\" data-kid=\"1-1-3-2-4-1-1-1\" data-name=\"badge icon wrapper\"><i class=\"ti ti-circle-check\" data-kid=\"1-1-3-2-4-1-1-1-1\" data-name=\"check circle icon\"></i></span>Supported result\n            </div>\n<p class=\"mt-3 text-[24px] font-semibold leading-8\" data-kid=\"1-1-3-2-4-1-2\" data-name=\"crop detection result title\">Tomato</p>\n<p class=\"text-[17px] font-medium leading-6 text-[#191919]/60\" data-kid=\"1-1-3-2-4-1-3\" data-name=\"disease name caption\">Early blight</p>\n<div class=\"mt-3.5 flex h-10 items-stretch gap-6 border-b border-black/10 text-[15px]\" data-kid=\"1-1-3-2-4-1-4\" data-name=\"result tabs row\">\n<div class=\"relative flex items-center font-semibold\" data-kid=\"1-1-3-2-4-1-4-1\" data-name=\"active treatment tab\">\n                Treatment\n                <span class=\"absolute -bottom-px left-0 h-[3px] w-full rounded-full bg-[#944BBB]\" data-kid=\"1-1-3-2-4-1-4-1-1\" data-name=\"active tab underline indicator\"></span>\n</div>\n<div class=\"flex items-center font-medium text-[#191919]/45\" data-kid=\"1-1-3-2-4-1-4-2\" data-name=\"symptoms tab\">Symptoms</div>\n<div class=\"flex items-center font-medium text-[#191919]/45\" data-kid=\"1-1-3-2-4-1-4-3\" data-name=\"prevention tab\">Prevention</div>\n</div>\n<ul class=\"mt-2.5 flex flex-col gap-2\" data-kid=\"1-1-3-2-4-1-5\" data-name=\"treatment recommendations list\">\n<li class=\"flex items-start gap-2.5 text-[16px] leading-[24px]\" data-kid=\"1-1-3-2-4-1-5-1\" data-name=\"recommendation list item\">\n<span class=\"mt-[8px] h-1.5 w-1.5 shrink-0 rounded-full bg-[#944BBB]\" data-kid=\"1-1-3-2-4-1-5-1-1\" data-name=\"list item bullet dot\"></span>\n<span class=\"min-w-0 flex-1 break-words\" data-kid=\"1-1-3-2-4-1-5-1-2\" data-name=\"recommendation text\">Apply fungicide containing chlorothalonil or mancozeb</span>\n</li>\n<li class=\"flex items-start gap-2.5 text-[16px] leading-[24px]\" data-kid=\"1-1-3-2-4-1-5-2\" data-name=\"recommendation list item\">\n<span class=\"mt-[8px] h-1.5 w-1.5 shrink-0 rounded-full bg-[#944BBB]\" data-kid=\"1-1-3-2-4-1-5-2-1\" data-name=\"list item bullet dot\"></span>\n<span class=\"min-w-0 flex-1 break-words\" data-kid=\"1-1-3-2-4-1-5-2-2\" data-name=\"recommendation text\">Remove infected leaves</span>\n</li>\n<li class=\"flex items-start gap-2.5 text-[16px] leading-[24px]\" data-kid=\"1-1-3-2-4-1-5-3\" data-name=\"recommendation list item\">\n<span class=\"mt-[8px] h-1.5 w-1.5 shrink-0 rounded-full bg-[#944BBB]\" data-kid=\"1-1-3-2-4-1-5-3-1\" data-name=\"list item bullet dot\"></span>\n<span class=\"min-w-0 flex-1 break-words\" data-kid=\"1-1-3-2-4-1-5-3-2\" data-name=\"recommendation text\">Improve air circulation</span>\n</li>\n</ul>\n<div class=\"mt-auto flex h-10 items-center justify-between border-t border-black/10 text-[14px] font-medium text-[#191919]/55\" data-kid=\"1-1-3-2-4-1-6\" data-name=\"result details footer link row\">\n              Result details\n              <span class=\"text-[18px] leading-none\" data-kid=\"1-1-3-2-4-1-6-1\" data-name=\"chevron icon wrapper\"><i class=\"ti ti-chevron-right\" data-kid=\"1-1-3-2-4-1-6-1-1\" data-name=\"chevron right arrow icon\"></i></span>\n</div>\n</div>\n</div>\n</div>\n</div>\n<!-- 4. Could not identify -->\n<div class=\"flex w-[375px] shrink-0 flex-col gap-3\" data-kid=\"1-1-4\" data-name=\"could not identify screen column\">\n<div class=\"text-[13px] font-medium leading-5 text-[#191919]/50\" data-kid=\"1-1-4-1\" data-name=\"could not identify step label text\">Could not identify</div>\n<div class=\"flex h-[812px] w-[375px] flex-col gap-4 overflow-hidden rounded-[28px] border border-black/5 bg-[#F5F4F9] p-4 shadow-[0_30px_60px_-30px_rgba(25,25,25,0.30)]\" data-kid=\"1-1-4-2\" data-name=\"phone mockup frame (could not identify screen)\">\n<div class=\"flex h-14 shrink-0 items-center\" data-kid=\"1-1-4-2-1\" data-name=\"app header bar\">\n<span class=\"text-[15px] font-semibold tracking-[-0.01em]\" data-kid=\"1-1-4-2-1-1\" data-name=\"app header title text\">Plant Disease Detection</span>\n</div>\n<div class=\"relative h-[256px] shrink-0 overflow-hidden rounded-[22px] border border-black/5 bg-[#DCDCDD]\" data-kid=\"1-1-4-2-2\" data-name=\"uploaded leaf photo container\">\n<img alt=\"Out-of-focus green leaves (Shakib Uzzaman on Unsplash)\" class=\"h-full w-full object-cover\" data-kid=\"1-1-4-2-2-1\" data-name=\"blurry leaf photo image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1690553563186-ea46190f1465?auto=format&amp;w=800&amp;q=80&amp;fit=crop\"/>\n</div>\n<div class=\"flex h-14 shrink-0 items-center\" data-kid=\"1-1-4-2-3\" data-name=\"photo action buttons row\">\n<button class=\"flex h-12 items-center gap-2 text-[15px] font-semibold text-[#191919]/55\" data-kid=\"1-1-4-2-3-1\" data-name=\"enlarge photo button\" type=\"button\">\n<span class=\"text-[20px] leading-none\" data-kid=\"1-1-4-2-3-1-1\" data-name=\"button icon wrapper\"><i class=\"ti ti-zoom-in\" data-kid=\"1-1-4-2-3-1-1-1\" data-name=\"zoom in icon\"></i></span>Enlarge photo\n          </button>\n</div>\n<div class=\"flex min-h-0 flex-1 flex-col\" data-kid=\"1-1-4-2-4\" data-name=\"result content wrapper\">\n<div class=\"flex min-h-0 flex-1 flex-col rounded-[24px] bg-[#8AB2CB] p-5\" data-kid=\"1-1-4-2-4-1\" data-name=\"low confidence message card\">\n<p class=\"text-[22px] font-semibold leading-7\" data-kid=\"1-1-4-2-4-1-1\" data-name=\"low confidence headline\">Could not identify the disease.</p>\n<p class=\"mt-2.5 text-[17px] leading-[25px] text-[#191919]/85\" data-kid=\"1-1-4-2-4-1-2\" data-name=\"low confidence explanation text\">Low confidence prediction. The model is uncertain about this classification. Please try a clearer image of the plant leaf.</p>\n<button class=\"mt-4 flex h-14 w-full items-center justify-center gap-2 rounded-full bg-[#191919] text-[16px] font-semibold text-[#F5F4F9]\" data-kid=\"1-1-4-2-4-1-3\" data-name=\"replace photo primary button\" type=\"button\">\n<span class=\"text-[20px] leading-none\" data-kid=\"1-1-4-2-4-1-3-1\" data-name=\"button icon wrapper\"><i class=\"ti ti-refresh\" data-kid=\"1-1-4-2-4-1-3-1-1\" data-name=\"refresh icon\"></i></span>Replace photo\n            </button>\n<div class=\"mt-auto flex h-10 items-center justify-between border-t border-[#191919]/20 text-[14px] font-medium text-[#191919]/60\" data-kid=\"1-1-4-2-4-1-4\" data-name=\"result details footer link row\">\n              Result details\n              <span class=\"text-[18px] leading-none\" data-kid=\"1-1-4-2-4-1-4-1\" data-name=\"chevron icon wrapper\"><i class=\"ti ti-chevron-right\" data-kid=\"1-1-4-2-4-1-4-1-1\" data-name=\"chevron right arrow icon\"></i></span>\n</div>\n</div>\n</div>\n</div>\n</div>\n<!-- 5. No supported result -->\n<div class=\"flex w-[375px] shrink-0 flex-col gap-3\" data-kid=\"1-1-5\" data-name=\"no supported result screen column\">\n<div class=\"text-[13px] font-medium leading-5 text-[#191919]/50\" data-kid=\"1-1-5-1\" data-name=\"no supported result step label text\">No supported result</div>\n<div class=\"flex h-[812px] w-[375px] flex-col gap-4 overflow-hidden rounded-[28px] border border-black/5 bg-[#F5F4F9] p-4 shadow-[0_30px_60px_-30px_rgba(25,25,25,0.30)]\" data-kid=\"1-1-5-2\" data-name=\"phone mockup frame (no supported result screen)\">\n<div class=\"flex h-14 shrink-0 items-center\" data-kid=\"1-1-5-2-1\" data-name=\"app header bar\">\n<span class=\"text-[15px] font-semibold tracking-[-0.01em]\" data-kid=\"1-1-5-2-1-1\" data-name=\"app header title text\">Plant Disease Detection</span>\n</div>\n<div class=\"relative h-[256px] shrink-0 overflow-hidden rounded-[22px] border border-black/5 bg-[#DCDCDD]\" data-kid=\"1-1-5-2-2\" data-name=\"uploaded leaf photo container\">\n<img alt=\"Out-of-focus green leaves (Shakib Uzzaman on Unsplash)\" class=\"h-full w-full object-cover\" data-kid=\"1-1-5-2-2-1\" data-name=\"blurry leaf photo image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1690553563186-ea46190f1465?auto=format&amp;w=800&amp;q=80&amp;fit=crop\"/>\n</div>\n<div class=\"flex h-14 shrink-0 items-center\" data-kid=\"1-1-5-2-3\" data-name=\"photo action buttons row\">\n<button class=\"flex h-12 items-center gap-2 text-[15px] font-semibold text-[#191919]/55\" data-kid=\"1-1-5-2-3-1\" data-name=\"enlarge photo button\" type=\"button\">\n<span class=\"text-[20px] leading-none\" data-kid=\"1-1-5-2-3-1-1\" data-name=\"button icon wrapper\"><i class=\"ti ti-zoom-in\" data-kid=\"1-1-5-2-3-1-1-1\" data-name=\"zoom in icon\"></i></span>Enlarge photo\n          </button>\n</div>\n<div class=\"flex min-h-0 flex-1 flex-col overflow-hidden rounded-[24px] border border-black/5 bg-white\" data-kid=\"1-1-5-2-4\" data-name=\"unsupported result card\">\n<div class=\"flex items-center gap-2 bg-[#531CB3] px-4 py-3 text-[14px] font-semibold text-[#F5F4F9]\" data-kid=\"1-1-5-2-4-1\" data-name=\"no supported result banner header\">\n<span class=\"text-[16px] leading-none\" data-kid=\"1-1-5-2-4-1-1\" data-name=\"banner icon wrapper\"><i class=\"ti ti-info-circle\" data-kid=\"1-1-5-2-4-1-1-1\" data-name=\"info circle icon\"></i></span>No supported result\n          </div>\n<div class=\"flex flex-1 flex-col p-4\" data-kid=\"1-1-5-2-4-2\" data-name=\"card body container\">\n<p class=\"text-[18px] leading-[26px]\" data-kid=\"1-1-5-2-4-2-1\" data-name=\"unsupported result explanation text\">This photo did not return a supported crop or disease.</p>\n<button class=\"mt-4 flex h-14 w-full items-center justify-center gap-2 rounded-full bg-[#531CB3] text-[16px] font-semibold text-[#F5F4F9]\" data-kid=\"1-1-5-2-4-2-2\" data-name=\"supported crops primary button\" type=\"button\">\n<span class=\"text-[20px] leading-none\" data-kid=\"1-1-5-2-4-2-2-1\" data-name=\"button icon wrapper\"><i class=\"ti ti-plant\" data-kid=\"1-1-5-2-4-2-2-1-1\" data-name=\"plant icon\"></i></span>Supported crops\n            </button>\n<button class=\"mt-1 flex h-12 w-full items-center justify-center gap-2 text-[15px] font-semibold text-[#191919]/55\" data-kid=\"1-1-5-2-4-2-3\" data-name=\"replace photo secondary button\" type=\"button\">\n<span class=\"text-[18px] leading-none\" data-kid=\"1-1-5-2-4-2-3-1\" data-name=\"button icon wrapper\"><i class=\"ti ti-refresh\" data-kid=\"1-1-5-2-4-2-3-1-1\" data-name=\"refresh icon\"></i></span>Replace photo\n            </button>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>",
