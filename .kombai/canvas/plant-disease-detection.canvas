      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;600&display=swap');\n  @import url(\"https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css\");\n\n  @keyframes kmbSweep {\n    0% { transform: translateX(-120%); }\n    100% { transform: translateX(320%); }\n  }\n  .kmb-sweep { animation: kmbSweep 1.7s ease-in-out infinite; }\n</style>\n<div class=\"min-h-full bg-[#EEF1F2] px-9 py-10 text-[#2F3E46]\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'Lexend',sans-serif\">\n<div class=\"flex items-start gap-8\" data-kid=\"1-1\" data-name=\"scrollable row of screen mockups\">\n<!-- Screen 1: Check a leaf -->\n<div class=\"shrink-0\" data-kid=\"1-1-1\" data-name=\"screen mockup 1, check a leaf\">\n<p class=\"mb-3 text-[13px] font-medium text-[#2F3E46]/55\" data-kid=\"1-1-1-1\" data-name=\"screen mockup label\">Check a leaf</p>\n<div class=\"h-[812px] w-[375px] overflow-hidden rounded-2xl border border-[#2F3E46]/10 bg-white shadow-[0_20px_44px_-28px_rgba(47,62,70,0.5)]\" data-kid=\"1-1-1-2\" data-name=\"phone frame container\">\n<div class=\"flex h-full flex-col\" data-kid=\"1-1-1-2-1\" data-name=\"phone screen content wrapper\">\n<div class=\"flex h-16 shrink-0 items-center border-b border-[#2F3E46]/10 px-5\" data-kid=\"1-1-1-2-1-1\" data-name=\"top app bar\">\n<span class=\"text-[15px] font-semibold\" data-kid=\"1-1-1-2-1-1-1\" data-name=\"app bar title\">Plant Disease Detection</span>\n</div>\n<div class=\"flex flex-1 flex-col px-5 pb-5 pt-6\" data-kid=\"1-1-1-2-1-2\" data-name=\"screen body content\">\n<h1 class=\"text-[28px] font-semibold leading-9\" data-kid=\"1-1-1-2-1-2-1\" data-name=\"check a leaf headline\">Check a leaf</h1>\n<div class=\"mt-6 flex h-[264px] shrink-0 flex-col items-center justify-center gap-3 rounded-2xl bg-[#DCDCDD]\" data-kid=\"1-1-1-2-1-2-2\" data-name=\"photo upload drop zone\">\n<span class=\"text-[32px] leading-none text-[#2F3E46]/70\" data-kid=\"1-1-1-2-1-2-2-1\" data-name=\"placeholder icon wrapper\"><i class=\"ph ph-camera\" data-kid=\"1-1-1-2-1-2-2-1-1\" data-name=\"camera icon\"></i></span>\n<p class=\"w-[212px] text-center text-[15px] leading-[22px] text-[#2F3E46]/70\" data-kid=\"1-1-1-2-1-2-2-2\" data-name=\"photo upload helper text\">One leaf, in focus, in daylight.</p>\n</div>\n<button class=\"mt-6 h-14 w-full rounded-[20px] bg-[#1985A1] text-[18px] font-medium text-[#08171A]\" data-kid=\"1-1-1-2-1-2-3\" data-name=\"primary take photo button\">Take photo</button>\n<button class=\"mt-3 h-14 w-full text-[17px] font-medium text-[#2F3E46]/80\" data-kid=\"1-1-1-2-1-2-4\" data-name=\"secondary choose photo button\">Choose photo</button>\n<div class=\"mt-7 flex h-14 items-center justify-between border-t border-[#2F3E46]/10\" data-kid=\"1-1-1-2-1-2-5\" data-name=\"bottom navigation row\">\n<span class=\"text-[17px] font-medium\" data-kid=\"1-1-1-2-1-2-5-1\" data-name=\"supported crops row label\">Supported crops</span>\n<span class=\"text-[20px] text-[#2F3E46]/45\" data-kid=\"1-1-1-2-1-2-5-2\" data-name=\"chevron icon wrapper\"><i class=\"ph ph-caret-right\" data-kid=\"1-1-1-2-1-2-5-2-1\" data-name=\"right chevron icon\"></i></span>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"shrink-0\" data-kid=\"1-1-2\" data-name=\"screen mockup 2, review photo\">\n<p class=\"mb-3 text-[13px] font-medium text-[#2F3E46]/55\" data-kid=\"1-1-2-1\" data-name=\"screen mockup label\">Review photo</p>\n<div class=\"h-[812px] w-[375px] overflow-hidden rounded-2xl border border-[#2F3E46]/10 bg-white shadow-[0_20px_44px_-28px_rgba(47,62,70,0.5)]\" data-kid=\"1-1-2-2\" data-name=\"phone frame container\">\n<div class=\"flex h-full flex-col\" data-kid=\"1-1-2-2-1\" data-name=\"phone screen content wrapper\">\n<div class=\"flex h-16 shrink-0 items-center gap-1 border-b border-[#2F3E46]/10 pl-2 pr-5\" data-kid=\"1-1-2-2-1-1\" data-name=\"top app bar with back button\">\n<span class=\"flex h-11 w-11 items-center justify-center text-[22px] text-[#2F3E46]/60\" data-kid=\"1-1-2-2-1-1-1\" data-name=\"back button\"><i class=\"ph ph-caret-left\" data-kid=\"1-1-2-2-1-1-1-1\" data-name=\"left chevron icon\"></i></span>\n<span class=\"text-[15px] font-semibold\" data-kid=\"1-1-2-2-1-1-2\" data-name=\"app bar title\">Plant Disease Detection</span>\n</div>\n<div class=\"flex flex-1 flex-col px-5 pb-5 pt-5\" data-kid=\"1-1-2-2-1-2\" data-name=\"screen body content\">\n<h1 class=\"text-[24px] font-semibold leading-8\" data-kid=\"1-1-2-2-1-2-1\" data-name=\"review photo headline\">Review photo</h1>\n<div class=\"mt-5 h-[300px] shrink-0 overflow-hidden rounded-2xl bg-[#DCDCDD]\" data-kid=\"1-1-2-2-1-2-2\" data-name=\"uploaded photo preview\">\n<img alt=\"Tomato leaf with brown spots (Nothing Ahead on Pexels)\" class=\"h-full w-full object-contain\" data-kid=\"1-1-2-2-1-2-2-1\" data-name=\"tomato leaf photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/7124505/pexels-photo-7124505.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=800&amp;q=80\"/>\n</div>\n<button class=\"mt-6 h-14 w-full rounded-[20px] bg-[#1985A1] text-[18px] font-medium text-[#08171A]\" data-kid=\"1-1-2-2-1-2-3\" data-name=\"primary check photo button\">Check photo</button>\n<button class=\"mt-3 flex h-14 w-full items-center justify-center gap-2 text-[17px] font-medium text-[#2F3E46]/80\" data-kid=\"1-1-2-2-1-2-4\" data-name=\"secondary replace photo button\">\n<span class=\"text-[20px]\" data-kid=\"1-1-2-2-1-2-4-1\" data-name=\"icon wrapper\"><i class=\"ph ph-arrow-counter-clockwise\" data-kid=\"1-1-2-2-1-2-4-1-1\" data-name=\"counter-clockwise arrow icon\"></i></span>\n              Replace photo\n            </button>\n</div>\n</div>\n</div>\n</div>\n<div class=\"shrink-0\" data-kid=\"1-1-3\" data-name=\"screen mockup 3, analysing state\">\n<p class=\"mb-3 text-[13px] font-medium text-[#2F3E46]/55\" data-kid=\"1-1-3-1\" data-name=\"screen mockup label\">Analysing</p>\n<div class=\"h-[812px] w-[375px] overflow-hidden rounded-2xl border border-[#2F3E46]/10 bg-white shadow-[0_20px_44px_-28px_rgba(47,62,70,0.5)]\" data-kid=\"1-1-3-2\" data-name=\"phone frame container\">\n<div class=\"flex h-full flex-col\" data-kid=\"1-1-3-2-1\" data-name=\"phone screen content wrapper\">\n<div class=\"flex h-16 shrink-0 items-center gap-1 border-b border-[#2F3E46]/10 pl-2 pr-5\" data-kid=\"1-1-3-2-1-1\" data-name=\"top app bar with back button\">\n<span class=\"flex h-11 w-11 items-center justify-center text-[22px] text-[#2F3E46]/60\" data-kid=\"1-1-3-2-1-1-1\" data-name=\"back button\"><i class=\"ph ph-caret-left\" data-kid=\"1-1-3-2-1-1-1-1\" data-name=\"left chevron icon\"></i></span>\n<span class=\"text-[15px] font-semibold\" data-kid=\"1-1-3-2-1-1-2\" data-name=\"app bar title\">Plant Disease Detection</span>\n</div>\n<div class=\"flex flex-1 flex-col px-5 pb-5 pt-5\" data-kid=\"1-1-3-2-1-2\" data-name=\"screen body content\">\n<h1 class=\"text-[24px] font-semibold leading-8\" data-kid=\"1-1-3-2-1-2-1\" data-name=\"check photo headline\">Check photo</h1>\n<div class=\"mt-5 h-[400px] shrink-0 overflow-hidden rounded-2xl bg-[#DCDCDD]\" data-kid=\"1-1-3-2-1-2-2\" data-name=\"uploaded photo preview\">\n<img alt=\"Tomato leaf with brown spots (Nothing Ahead on Pexels)\" class=\"h-full w-full object-contain\" data-kid=\"1-1-3-2-1-2-2-1\" data-name=\"tomato leaf photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/7124505/pexels-photo-7124505.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=800&amp;q=80\"/>\n</div>\n<div class=\"mt-6 flex h-14 shrink-0 items-center gap-3 rounded-xl bg-[#F8F8F6] px-4\" data-kid=\"1-1-3-2-1-2-3\" data-name=\"analysing status row\">\n<span class=\"relative h-1.5 w-14 overflow-hidden rounded-full bg-[#2F3E46]/15\" data-kid=\"1-1-3-2-1-2-3-1\" data-name=\"indeterminate progress track\">\n<span class=\"kmb-sweep absolute inset-y-0 left-0 w-1/2 rounded-full bg-[#1985A1]\" data-kid=\"1-1-3-2-1-2-3-1-1\" data-name=\"indeterminate progress sweep\"></span>\n</span>\n<span class=\"text-[16px] font-medium text-[#2F3E46]/85\" data-kid=\"1-1-3-2-1-2-3-2\" data-name=\"analysing status text\">Analysing photo</span>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"shrink-0\" data-kid=\"1-1-4\" data-name=\"screen mockup 4, diagnosis result\">\n<p class=\"mb-3 text-[13px] font-medium text-[#2F3E46]/55\" data-kid=\"1-1-4-1\" data-name=\"screen mockup label\">Diagnosis</p>\n<div class=\"h-[812px] w-[375px] overflow-hidden rounded-2xl border border-[#2F3E46]/10 bg-white shadow-[0_20px_44px_-28px_rgba(47,62,70,0.5)]\" data-kid=\"1-1-4-2\" data-name=\"phone frame container\">\n<div class=\"flex h-full flex-col\" data-kid=\"1-1-4-2-1\" data-name=\"phone screen content wrapper\">\n<div class=\"flex h-16 shrink-0 items-center gap-1 border-b border-[#2F3E46]/10 pl-2 pr-5\" data-kid=\"1-1-4-2-1-1\" data-name=\"top app bar with back button\">\n<span class=\"flex h-11 w-11 items-center justify-center text-[22px] text-[#2F3E46]/60\" data-kid=\"1-1-4-2-1-1-1\" data-name=\"back button\"><i class=\"ph ph-caret-left\" data-kid=\"1-1-4-2-1-1-1-1\" data-name=\"left chevron icon\"></i></span>\n<span class=\"text-[15px] font-semibold\" data-kid=\"1-1-4-2-1-1-2\" data-name=\"app bar title\">Plant Disease Detection</span>\n</div>\n<div class=\"flex flex-1 flex-col px-5 pb-5 pt-5\" data-kid=\"1-1-4-2-1-2\" data-name=\"screen body content\">\n<div class=\"flex items-center gap-4\" data-kid=\"1-1-4-2-1-2-1\" data-name=\"diagnosis header row\">\n<img alt=\"Tomato leaf with brown spots (Nothing Ahead on Pexels)\" class=\"h-16 w-16 shrink-0 rounded-xl object-cover\" data-kid=\"1-1-4-2-1-2-1-1\" data-name=\"crop thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/7124505/pexels-photo-7124505.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400&amp;q=80\"/>\n<div data-kid=\"1-1-4-2-1-2-1-2\" data-name=\"diagnosis label wrapper\">\n<p class=\"text-[24px] font-semibold leading-7\" data-kid=\"1-1-4-2-1-2-1-2-1\" data-name=\"crop name text\">Tomato</p>\n<p class=\"text-[20px] font-medium leading-7 text-[#2F3E46]/80\" data-kid=\"1-1-4-2-1-2-1-2-2\" data-name=\"disease name text\">Early blight</p>\n</div>\n</div>\n<div class=\"mt-7 flex items-center justify-between\" data-kid=\"1-1-4-2-1-2-2\" data-name=\"treatment section header\">\n<span class=\"text-[15px] font-medium text-[#2F3E46]/55\" data-kid=\"1-1-4-2-1-2-2-1\" data-name=\"treatment row label\">Treatment</span>\n<span class=\"text-[15px] font-medium text-[#2F3E46]/40\" data-kid=\"1-1-4-2-1-2-2-2\" data-name=\"treatment item count\">3 items</span>\n</div>\n<ul class=\"mt-1 border-t border-[#2F3E46]/10\" data-kid=\"1-1-4-2-1-2-3\" data-name=\"treatment list\">\n<li class=\"flex items-start gap-3 border-b border-[#2F3E46]/10 py-4\" data-kid=\"1-1-4-2-1-2-3-1\" data-name=\"treatment list item\">\n<span class=\"mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[#1985A1]\" data-kid=\"1-1-4-2-1-2-3-1-1\" data-name=\"bullet dot indicator\"></span>\n<span class=\"text-[18px] leading-[26px]\" data-kid=\"1-1-4-2-1-2-3-1-2\" data-name=\"treatment step text\">Apply fungicide containing chlorothalonil or mancozeb</span>\n</li>\n<li class=\"flex items-start gap-3 border-b border-[#2F3E46]/10 py-4\" data-kid=\"1-1-4-2-1-2-3-2\" data-name=\"treatment list item\">\n<span class=\"mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[#1985A1]\" data-kid=\"1-1-4-2-1-2-3-2-1\" data-name=\"bullet dot indicator\"></span>\n<span class=\"text-[18px] leading-[26px]\" data-kid=\"1-1-4-2-1-2-3-2-2\" data-name=\"treatment step text\">Remove infected leaves</span>\n</li>\n<li class=\"flex items-start gap-3 border-b border-[#2F3E46]/10 py-4\" data-kid=\"1-1-4-2-1-2-3-3\" data-name=\"treatment list item\">\n<span class=\"mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[#1985A1]\" data-kid=\"1-1-4-2-1-2-3-3-1\" data-name=\"bullet dot indicator\"></span>\n<span class=\"text-[18px] leading-[26px]\" data-kid=\"1-1-4-2-1-2-3-3-2\" data-name=\"treatment step text\">Improve air circulation</span>\n</li>\n</ul>\n<div class=\"mt-5 border-t border-[#2F3E46]/10\" data-kid=\"1-1-4-2-1-2-4\" data-name=\"expandable info rows section\">\n<div class=\"flex h-14 items-center justify-between border-b border-[#2F3E46]/10\" data-kid=\"1-1-4-2-1-2-4-1\" data-name=\"symptoms row\">\n<span class=\"text-[17px] font-medium\" data-kid=\"1-1-4-2-1-2-4-1-1\" data-name=\"symptoms row label\">Symptoms</span>\n<span class=\"flex items-center gap-2 text-[17px] text-[#2F3E46]/50\" data-kid=\"1-1-4-2-1-2-4-1-2\" data-name=\"symptoms count and chevron\"><span data-kid=\"1-1-4-2-1-2-4-1-2-1\" data-name=\"symptoms count number\">4</span><i class=\"ph ph-caret-right\" data-kid=\"1-1-4-2-1-2-4-1-2-2\" data-name=\"right chevron icon\"></i></span>\n</div>\n<div class=\"flex h-14 items-center justify-between border-b border-[#2F3E46]/10\" data-kid=\"1-1-4-2-1-2-4-2\" data-name=\"prevention row\">\n<span class=\"text-[17px] font-medium\" data-kid=\"1-1-4-2-1-2-4-2-1\" data-name=\"prevention row label\">Prevention</span>\n<span class=\"flex items-center gap-2 text-[17px] text-[#2F3E46]/50\" data-kid=\"1-1-4-2-1-2-4-2-2\" data-name=\"prevention count and chevron\"><span data-kid=\"1-1-4-2-1-2-4-2-2-1\" data-name=\"prevention count number\">3</span><i class=\"ph ph-caret-right\" data-kid=\"1-1-4-2-1-2-4-2-2-2\" data-name=\"right chevron icon\"></i></span>\n</div>\n<div class=\"flex h-14 items-center justify-between\" data-kid=\"1-1-4-2-1-2-4-3\" data-name=\"model confidence row\">\n<span class=\"text-[17px] font-medium text-[#2F3E46]/70\" data-kid=\"1-1-4-2-1-2-4-3-1\" data-name=\"model confidence label\">Model confidence</span>\n<span class=\"text-[17px] text-[#2F3E46]/50\" data-kid=\"1-1-4-2-1-2-4-3-2\" data-name=\"model confidence value\">93%</span>\n</div>\n</div>\n<button class=\"mt-6 flex h-14 w-full items-center justify-center gap-2 text-[17px] font-medium text-[#2F3E46]/80\" data-kid=\"1-1-4-2-1-2-5\" data-name=\"secondary check another photo button\">\n<span class=\"text-[20px]\" data-kid=\"1-1-4-2-1-2-5-1\" data-name=\"icon wrapper\"><i class=\"ph ph-camera\" data-kid=\"1-1-4-2-1-2-5-1-1\" data-name=\"camera icon\"></i></span>\n              Check another photo\n            </button>\n</div>\n</div>\n</div>\n</div>\n<div class=\"shrink-0\" data-kid=\"1-1-5\" data-name=\"screen mockup 5, low confidence\">\n<p class=\"mb-3 text-[13px] font-medium text-[#2F3E46]/55\" data-kid=\"1-1-5-1\" data-name=\"screen mockup label\">Low confidence</p>\n<div class=\"h-[812px] w-[375px] overflow-hidden rounded-2xl border border-[#2F3E46]/10 bg-white shadow-[0_20px_44px_-28px_rgba(47,62,70,0.5)]\" data-kid=\"1-1-5-2\" data-name=\"phone frame container\">\n<div class=\"flex h-full flex-col\" data-kid=\"1-1-5-2-1\" data-name=\"phone screen content wrapper\">\n<div class=\"flex h-16 shrink-0 items-center gap-1 border-b border-[#2F3E46]/10 pl-2 pr-5\" data-kid=\"1-1-5-2-1-1\" data-name=\"top app bar with back button\">\n<span class=\"flex h-11 w-11 items-center justify-center text-[22px] text-[#2F3E46]/60\" data-kid=\"1-1-5-2-1-1-1\" data-name=\"back button\"><i class=\"ph ph-caret-left\" data-kid=\"1-1-5-2-1-1-1-1\" data-name=\"left chevron icon\"></i></span>\n<span class=\"text-[15px] font-semibold\" data-kid=\"1-1-5-2-1-1-2\" data-name=\"app bar title\">Plant Disease Detection</span>\n</div>\n<div class=\"flex flex-1 flex-col px-5 pb-5 pt-5\" data-kid=\"1-1-5-2-1-2\" data-name=\"screen body content\">\n<div class=\"h-[140px] shrink-0 overflow-hidden rounded-2xl bg-[#DCDCDD]\" data-kid=\"1-1-5-2-1-2-1\" data-name=\"uploaded photo preview\">\n<img alt=\"Out-of-focus green leaves (Shakib Uzzaman on Unsplash)\" class=\"h-full w-full object-cover\" data-kid=\"1-1-5-2-1-2-1-1\" data-name=\"blurry leaf photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1690553563186-ea46190f1465?auto=format&amp;w=800&amp;q=80&amp;fit=crop\"/>\n</div>\n<h1 class=\"mt-7 text-[24px] font-semibold leading-8 text-[#B34D4D]\" data-kid=\"1-1-5-2-1-2-2\" data-name=\"error state headline\">Could not identify the disease.</h1>\n<p class=\"mt-3 text-[17px] leading-[26px] text-[#2F3E46]/75\" data-kid=\"1-1-5-2-1-2-3\" data-name=\"error state description text\">Low confidence prediction. The model is uncertain about this classification. Please try a clearer image of the plant leaf.</p>\n<button class=\"mt-7 h-14 w-full rounded-[20px] bg-[#1985A1] text-[18px] font-medium text-[#08171A]\" data-kid=\"1-1-5-2-1-2-4\" data-name=\"primary take another photo button\">Take another photo</button>\n<button class=\"mt-3 h-14 w-full text-[17px] font-medium text-[#2F3E46]/80\" data-kid=\"1-1-5-2-1-2-5\" data-name=\"secondary choose photo button\">Choose photo</button>\n<div class=\"mt-auto flex h-14 items-center justify-between border-t border-[#2F3E46]/10\" data-kid=\"1-1-5-2-1-2-6\" data-name=\"model confidence row\">\n<span class=\"text-[17px] font-medium text-[#2F3E46]/70\" data-kid=\"1-1-5-2-1-2-6-1\" data-name=\"model confidence label\">Model confidence</span>\n<span class=\"text-[17px] text-[#2F3E46]/50\" data-kid=\"1-1-5-2-1-2-6-2\" data-name=\"model confidence value\">26%</span>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>",
