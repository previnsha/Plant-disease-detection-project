    "var_8e40254fe1aa": {
      "type": "variant",
      "label": "Treatment reading flow — mobile",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 3720,
        "y": 0,
        "w": 2080,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Zilla+Slab:wght@400;500;600&family=Chivo:wght@400;500;600&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/remixicon@4.9.1/fonts/remixicon.css');\n</style>\n<div class=\"min-h-screen w-full bg-[#EFE9E6] px-[38px] py-[40px]\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'Chivo',sans-serif;color:#1C1410;\">\n<div class=\"flex items-start gap-[32px]\" data-kid=\"1-1\" data-name=\"screen layout row\">\n<!-- SCREEN 1 -->\n<div class=\"shrink-0 w-[375px]\" data-kid=\"1-1-1\" data-name=\"screen 1 check a leaf mockup\">\n<div class=\"mb-[12px] text-[13px] font-medium text-[#6C5D55]\" data-kid=\"1-1-1-1\" data-name=\"screen 1 label caption\">Check a leaf</div>\n<div class=\"relative flex h-[812px] w-[375px] flex-col overflow-hidden border border-[#1C1410]/15 bg-[#F9F4F2]\" data-kid=\"1-1-1-2\" data-name=\"smartphone frame\">\n<div class=\"flex h-[64px] shrink-0 items-center gap-[8px] border-b border-[#1C1410]/12 px-[24px]\" data-kid=\"1-1-1-2-1\" data-name=\"app header bar\">\n<i class=\"ri-leaf-line text-[18px] text-[#CC5803]\" data-kid=\"1-1-1-2-1-1\" data-name=\"orange leaf logo icon\"></i>\n<span class=\"text-[15px] font-semibold\" data-kid=\"1-1-1-2-1-2\" data-name=\"app title text\">Plant Disease Detection</span>\n</div>\n<div class=\"flex flex-1 flex-col px-[24px] pb-[24px] pt-[24px]\" data-kid=\"1-1-1-2-2\" data-name=\"screen 1 main content container\">\n<h1 class=\"text-[28px] font-semibold leading-[34px]\" data-kid=\"1-1-1-2-2-1\" data-name=\"screen 1 headline\" style=\"font-family:'Zilla Slab',serif;\">Check a leaf</h1>\n<div class=\"mt-[24px] flex flex-1 flex-col items-center justify-center gap-[12px] bg-[#EDE4DF] shadow-[inset_0_0_0_1px_rgba(28,20,16,0.07)]\" data-kid=\"1-1-1-2-2-2\" data-name=\"camera placeholder card\" style=\"clip-path:polygon(0 0, calc(100% - 12px) 0, 100% 12px, 100% 100%, 0 100%);\">\n<i class=\"ri-camera-line text-[40px] text-[#8A776C]\" data-kid=\"1-1-1-2-2-2-1\" data-name=\"camera line icon\"></i>\n<p class=\"text-center text-[14px] leading-[20px] text-[#7A675C]\" data-kid=\"1-1-1-2-2-2-2\" data-name=\"placeholder help text\">One leaf, in focus, in daylight.</p>\n</div>\n<button class=\"mt-[24px] flex h-[56px] w-full items-center justify-center gap-[8px] bg-[#CC5803] text-[17px] font-semibold text-[#1A1008]\" data-kid=\"1-1-1-2-2-3\" data-name=\"primary take photo button\">\n<i class=\"ri-camera-line text-[22px]\" data-kid=\"1-1-1-2-2-3-1\" data-name=\"camera line icon\"></i>\n            Take photo\n          </button>\n<button class=\"mt-[12px] flex h-[56px] w-full items-center justify-center text-[16px] text-[#1C1410] underline decoration-[#1C1410]/40 underline-offset-4\" data-kid=\"1-1-1-2-2-4\" data-name=\"secondary choose photo link button\">\n            Choose photo\n          </button>\n<div class=\"mt-[24px] flex h-[56px] items-center justify-between border-t border-[#1C1410]/12\" data-kid=\"1-1-1-2-2-5\" data-name=\"supported crops nav row\">\n<span class=\"flex items-center gap-[10px] text-[16px]\" data-kid=\"1-1-1-2-2-5-1\" data-name=\"supported crops label with icon\">\n<i class=\"ri-list-check text-[22px] text-[#8A776C]\" data-kid=\"1-1-1-2-2-5-1-1\" data-name=\"checklist line icon\"></i>\n              Supported crops\n            </span>\n<i class=\"ri-arrow-right-s-line text-[22px] text-[#8A776C]\" data-kid=\"1-1-1-2-2-5-2\" data-name=\"right arrow navigation icon\"></i>\n</div>\n</div>\n</div>\n</div>\n<!-- SCREEN 2 -->\n<div class=\"shrink-0 w-[375px]\" data-kid=\"1-1-2\" data-name=\"screen 2 review photo mockup\">\n<div class=\"mb-[12px] text-[13px] font-medium text-[#6C5D55]\" data-kid=\"1-1-2-1\" data-name=\"screen 2 label caption\">Review photo</div>\n<div class=\"relative flex h-[812px] w-[375px] flex-col overflow-hidden border border-[#1C1410]/15 bg-[#F9F4F2]\" data-kid=\"1-1-2-2\" data-name=\"smartphone frame\">\n<div class=\"flex h-[64px] shrink-0 items-center gap-[8px] border-b border-[#1C1410]/12 px-[24px]\" data-kid=\"1-1-2-2-1\" data-name=\"app header bar\">\n<i class=\"ri-leaf-line text-[18px] text-[#CC5803]\" data-kid=\"1-1-2-2-1-1\" data-name=\"orange leaf logo icon\"></i>\n<span class=\"text-[15px] font-semibold\" data-kid=\"1-1-2-2-1-2\" data-name=\"app title text\">Plant Disease Detection</span>\n</div>\n<div class=\"flex flex-1 flex-col px-[24px] pb-[24px] pt-[24px]\" data-kid=\"1-1-2-2-2\" data-name=\"screen 2 main content container\">\n<div class=\"flex h-[48px] items-center\" data-kid=\"1-1-2-2-2-1\" data-name=\"screen 2 title row\">\n<h1 class=\"text-[26px] font-semibold leading-[32px]\" data-kid=\"1-1-2-2-2-1-1\" data-name=\"screen 2 headline\" style=\"font-family:'Zilla Slab',serif;\">Review photo</h1>\n</div>\n<div class=\"mt-[16px] h-[392px] w-full bg-[#EDE4DF] shadow-[inset_0_0_0_1px_rgba(28,20,16,0.10)]\" data-kid=\"1-1-2-2-2-2\" data-name=\"uploaded photo display container\">\n<img alt=\"Tomato leaf with brown spots (Nothing Ahead on Pexels)\" class=\"h-full w-full object-contain\" data-kid=\"1-1-2-2-2-2-1\" data-name=\"tomato leaf photo image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/7124505/pexels-photo-7124505.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=800&amp;q=80\"/>\n</div>\n<button class=\"mt-[24px] flex h-[56px] w-full items-center justify-center bg-[#CC5803] text-[17px] font-semibold text-[#1A1008]\" data-kid=\"1-1-2-2-2-3\" data-name=\"primary check photo button\">\n            Check photo\n          </button>\n<button class=\"mt-[12px] flex h-[56px] w-full items-center justify-center text-[16px] text-[#1C1410] underline decoration-[#1C1410]/40 underline-offset-4\" data-kid=\"1-1-2-2-2-4\" data-name=\"secondary replace photo link button\">\n            Replace photo\n          </button>\n</div>\n</div>\n</div>\n<!-- SCREEN 3 -->\n<div class=\"shrink-0 w-[375px]\" data-kid=\"1-1-3\" data-name=\"screen 3 treatment mockup\">\n<div class=\"mb-[12px] text-[13px] font-medium text-[#6C5D55]\" data-kid=\"1-1-3-1\" data-name=\"screen 3 label caption\">Treatment</div>\n<div class=\"relative flex h-[812px] w-[375px] flex-col overflow-hidden border border-[#1C1410]/15 bg-[#F9F4F2]\" data-kid=\"1-1-3-2\" data-name=\"smartphone frame\">\n<div class=\"flex h-[64px] shrink-0 items-center gap-[8px] border-b border-[#1C1410]/12 px-[24px]\" data-kid=\"1-1-3-2-1\" data-name=\"app header bar\">\n<i class=\"ri-leaf-line text-[18px] text-[#CC5803]\" data-kid=\"1-1-3-2-1-1\" data-name=\"orange leaf logo icon\"></i>\n<span class=\"text-[15px] font-semibold\" data-kid=\"1-1-3-2-1-2\" data-name=\"app title text\">Plant Disease Detection</span>\n</div>\n<div class=\"flex flex-1 flex-col px-[24px] pb-[24px] pt-[24px]\" data-kid=\"1-1-3-2-2\" data-name=\"screen 3 main content container\">\n<div class=\"flex h-[96px] flex-col justify-center\" data-kid=\"1-1-3-2-2-1\" data-name=\"detection result heading block\">\n<p class=\"text-[28px] font-semibold leading-[34px]\" data-kid=\"1-1-3-2-2-1-1\" data-name=\"detected crop name title\" style=\"font-family:'Zilla Slab',serif;\">Tomato</p>\n<p class=\"mt-[6px] text-[17px] leading-[22px] text-[#6C5D55]\" data-kid=\"1-1-3-2-2-1-2\" data-name=\"detected disease name subtitle\">Early blight</p>\n</div>\n<div class=\"mt-[16px] flex h-[56px] items-center justify-between border-y border-[#1C1410]/12\" data-kid=\"1-1-3-2-2-2\" data-name=\"treatment tab bar\">\n<div class=\"flex flex-col justify-center\" data-kid=\"1-1-3-2-2-2-1\" data-name=\"active treatment tab with underline\">\n<span class=\"text-[17px] font-semibold leading-[20px]\" data-kid=\"1-1-3-2-2-2-1-1\" data-name=\"treatment tab label\">Treatment</span>\n<span class=\"mt-[7px] block h-[2px] w-[72px] bg-[#CC5803]\" data-kid=\"1-1-3-2-2-2-1-2\" data-name=\"tab active underline indicator\"></span>\n</div>\n<i class=\"ri-arrow-down-s-line text-[22px] text-[#8A776C]\" data-kid=\"1-1-3-2-2-2-2\" data-name=\"downward arrow icon\"></i>\n</div>\n<div class=\"mt-[16px] flex flex-1 flex-col gap-[16px] bg-white px-[20px] py-[20px] shadow-[inset_0_0_0_1px_rgba(28,20,16,0.10)]\" data-kid=\"1-1-3-2-2-3\" data-name=\"treatment recommendations card panel\">\n<div class=\"flex min-h-[64px] items-start gap-[12px]\" data-kid=\"1-1-3-2-2-3-1\" data-name=\"treatment recommendation row 1\">\n<span class=\"mt-[13px] block h-[2px] w-[14px] shrink-0 bg-[#CC5803]\" data-kid=\"1-1-3-2-2-3-1-1\" data-name=\"orange list marker bar\"></span>\n<p class=\"min-w-0 flex-1 break-words text-[20px] leading-[28px]\" data-kid=\"1-1-3-2-2-3-1-2\" data-name=\"recommendation text 1\" style=\"font-family:'Zilla Slab',serif;\">Apply fungicide containing chlorothalonil or mancozeb</p>\n</div>\n<div class=\"flex min-h-[64px] items-start gap-[12px]\" data-kid=\"1-1-3-2-2-3-2\" data-name=\"treatment recommendation row 2\">\n<span class=\"mt-[13px] block h-[2px] w-[14px] shrink-0 bg-[#CC5803]\" data-kid=\"1-1-3-2-2-3-2-1\" data-name=\"orange list marker bar\"></span>\n<p class=\"min-w-0 flex-1 break-words text-[20px] leading-[28px]\" data-kid=\"1-1-3-2-2-3-2-2\" data-name=\"recommendation text 2\" style=\"font-family:'Zilla Slab',serif;\">Remove infected leaves</p>\n</div>\n<div class=\"flex min-h-[64px] items-start gap-[12px]\" data-kid=\"1-1-3-2-2-3-3\" data-name=\"treatment recommendation row 3\">\n<span class=\"mt-[13px] block h-[2px] w-[14px] shrink-0 bg-[#CC5803]\" data-kid=\"1-1-3-2-2-3-3-1\" data-name=\"orange list marker bar\"></span>\n<p class=\"min-w-0 flex-1 break-words text-[20px] leading-[28px]\" data-kid=\"1-1-3-2-2-3-3-2\" data-name=\"recommendation text 3\" style=\"font-family:'Zilla Slab',serif;\">Improve air circulation</p>\n</div>\n</div>\n<div class=\"mt-[28px]\" data-kid=\"1-1-3-2-2-4\" data-name=\"screen 3 footer actions area\">\n<div class=\"flex h-[56px] items-center justify-between border-t border-[#1C1410]/12\" data-kid=\"1-1-3-2-2-4-1\" data-name=\"about this result nav row\">\n<span class=\"flex items-center gap-[10px] text-[16px]\" data-kid=\"1-1-3-2-2-4-1-1\" data-name=\"about this result label with icon\">\n<i class=\"ri-information-line text-[22px] text-[#8A776C]\" data-kid=\"1-1-3-2-2-4-1-1-1\" data-name=\"information line icon\"></i>\n                About this result\n              </span>\n<i class=\"ri-arrow-right-s-line text-[22px] text-[#8A776C]\" data-kid=\"1-1-3-2-2-4-1-2\" data-name=\"right arrow navigation icon\"></i>\n</div>\n<div class=\"flex h-[56px] items-center justify-between border-t border-[#1C1410]/12\" data-kid=\"1-1-3-2-2-4-2\" data-name=\"review photo nav row\">\n<span class=\"flex items-center gap-[10px] text-[16px]\" data-kid=\"1-1-3-2-2-4-2-1\" data-name=\"review photo label with icon\">\n<i class=\"ri-image-line text-[22px] text-[#8A776C]\" data-kid=\"1-1-3-2-2-4-2-1-1\" data-name=\"image line icon\"></i>\n                Review photo\n              </span>\n<i class=\"ri-arrow-right-s-line text-[22px] text-[#8A776C]\" data-kid=\"1-1-3-2-2-4-2-2\" data-name=\"right arrow navigation icon\"></i>\n</div>\n<button class=\"flex h-[56px] w-full items-center justify-center text-[16px] text-[#1C1410] underline decoration-[#1C1410]/40 underline-offset-4\" data-kid=\"1-1-3-2-2-4-3\" data-name=\"check another photo link button\">\n              Check another photo\n            </button>\n</div>\n</div>\n</div>\n</div>\n<!-- SCREEN 4 -->\n<div class=\"shrink-0 w-[375px]\" data-kid=\"1-1-4\" data-name=\"screen 4 could not identify mockup\">\n<div class=\"mb-[12px] text-[13px] font-medium text-[#6C5D55]\" data-kid=\"1-1-4-1\" data-name=\"screen 4 label caption\">Could not identify</div>\n<div class=\"relative flex h-[812px] w-[375px] flex-col overflow-hidden border border-[#1C1410]/15 bg-[#F9F4F2]\" data-kid=\"1-1-4-2\" data-name=\"smartphone frame\">\n<div class=\"flex h-[64px] shrink-0 items-center gap-[8px] border-b border-[#1C1410]/12 px-[24px]\" data-kid=\"1-1-4-2-1\" data-name=\"app header bar\">\n<i class=\"ri-leaf-line text-[18px] text-[#CC5803]\" data-kid=\"1-1-4-2-1-1\" data-name=\"orange leaf logo icon\"></i>\n<span class=\"text-[15px] font-semibold\" data-kid=\"1-1-4-2-1-2\" data-name=\"app title text\">Plant Disease Detection</span>\n</div>\n<div class=\"flex flex-1 flex-col px-[24px] pb-[24px] pt-[24px]\" data-kid=\"1-1-4-2-2\" data-name=\"screen 4 main content container\">\n<div class=\"h-[248px] w-full bg-[#EDE4DF]\" data-kid=\"1-1-4-2-2-1\" data-name=\"uploaded photo display container\">\n<img alt=\"Green leaves in daylight (Miguel Á. Padriñán on Pexels)\" class=\"h-full w-full object-cover\" data-kid=\"1-1-4-2-2-1-1\" data-name=\"green leaves photo image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/68560/pexels-photo-68560.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=800&amp;q=80\"/>\n</div>\n<div class=\"mt-[24px] bg-[#1C1410] p-[24px]\" data-kid=\"1-1-4-2-2-2\" data-name=\"error result dark panel\">\n<h1 class=\"text-[24px] font-semibold leading-[30px] text-[#F6E7DF]\" data-kid=\"1-1-4-2-2-2-1\" data-name=\"error headline text\" style=\"font-family:'Zilla Slab',serif;\">Could not identify the disease.</h1>\n<p class=\"mt-[12px] text-[15px] leading-[23px] text-[#F6E7DF]/75\" data-kid=\"1-1-4-2-2-2-2\" data-name=\"error explanatory text\">Low confidence prediction. The model is uncertain about this classification. Please try a clearer image of the plant leaf.</p>\n<button class=\"mt-[24px] flex h-[56px] w-full items-center justify-center gap-[8px] border border-[#F6E7DF]/35 text-[17px] font-semibold text-[#F6E7DF]\" data-kid=\"1-1-4-2-2-2-3\" data-name=\"primary take another photo button\">\n<i class=\"ri-camera-line text-[22px]\" data-kid=\"1-1-4-2-2-2-3-1\" data-name=\"camera line icon\"></i>\n              Take another photo\n            </button>\n<button class=\"mt-[12px] flex h-[48px] w-full items-center justify-center text-[16px] text-[#F6E7DF] underline decoration-[#F6E7DF]/40 underline-offset-4\" data-kid=\"1-1-4-2-2-2-4\" data-name=\"secondary choose photo link button\">\n              Choose photo\n            </button>\n</div>\n<div class=\"mt-auto\" data-kid=\"1-1-4-2-2-3\" data-name=\"screen 4 footer actions container\">\n<div class=\"flex h-[56px] items-center justify-between border-t border-[#1C1410]/12\" data-kid=\"1-1-4-2-2-3-1\" data-name=\"review photo nav row\">\n<span class=\"flex items-center gap-[10px] text-[16px]\" data-kid=\"1-1-4-2-2-3-1-1\" data-name=\"review photo label with icon\">\n<i class=\"ri-image-line text-[22px] text-[#8A776C]\" data-kid=\"1-1-4-2-2-3-1-1-1\" data-name=\"image line icon\"></i>\n                Review photo\n              </span>\n<i class=\"ri-arrow-right-s-line text-[22px] text-[#8A776C]\" data-kid=\"1-1-4-2-2-3-1-2\" data-name=\"right arrow navigation icon\"></i>\n</div>\n</div>\n</div>\n</div>\n</div>\n<!-- SCREEN 5 -->\n<div class=\"shrink-0 w-[375px]\" data-kid=\"1-1-5\" data-name=\"screen 5 no supported result mockup\">\n<div class=\"mb-[12px] text-[13px] font-medium text-[#6C5D55]\" data-kid=\"1-1-5-1\" data-name=\"screen 5 label caption\">No supported result</div>\n<div class=\"relative flex h-[812px] w-[375px] flex-col overflow-hidden border border-[#1C1410]/15 bg-[#F9F4F2]\" data-kid=\"1-1-5-2\" data-name=\"smartphone frame\">\n<div class=\"flex h-[64px] shrink-0 items-center gap-[8px] border-b border-[#1C1410]/12 px-[24px]\" data-kid=\"1-1-5-2-1\" data-name=\"app header bar\">\n<i class=\"ri-leaf-line text-[18px] text-[#CC5803]\" data-kid=\"1-1-5-2-1-1\" data-name=\"orange leaf logo icon\"></i>\n<span class=\"text-[15px] font-semibold\" data-kid=\"1-1-5-2-1-2\" data-name=\"app title text\">Plant Disease Detection</span>\n</div>\n<div class=\"flex flex-1 flex-col px-[24px] pb-[24px] pt-[24px]\" data-kid=\"1-1-5-2-2\" data-name=\"screen 5 main content container\">\n<div class=\"h-[248px] w-full bg-[#EDE4DF]\" data-kid=\"1-1-5-2-2-1\" data-name=\"uploaded photo display container\">\n<img alt=\"Green leaves in daylight (Miguel Á. Padriñán on Pexels)\" class=\"h-full w-full object-cover\" data-kid=\"1-1-5-2-2-1-1\" data-name=\"green leaves photo image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/68560/pexels-photo-68560.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=800&amp;q=80\"/>\n</div>\n<div class=\"mt-[24px] bg-[#1C1410] p-[24px]\" data-kid=\"1-1-5-2-2-2\" data-name=\"unsupported result dark panel\">\n<h1 class=\"text-[24px] font-semibold leading-[30px] text-[#F6E7DF]\" data-kid=\"1-1-5-2-2-2-1\" data-name=\"unsupported result headline\" style=\"font-family:'Zilla Slab',serif;\">No supported result</h1>\n<p class=\"mt-[12px] text-[15px] leading-[23px] text-[#F6E7DF]/75\" data-kid=\"1-1-5-2-2-2-2\" data-name=\"explanatory text for unsupported crop\">This photo did not return a supported crop or disease.</p>\n<button class=\"mt-[24px] flex h-[56px] w-full items-center justify-center gap-[8px] border border-[#F6E7DF]/35 text-[17px] font-semibold text-[#F6E7DF]\" data-kid=\"1-1-5-2-2-2-3\" data-name=\"primary supported crops button\">\n<i class=\"ri-list-check text-[22px]\" data-kid=\"1-1-5-2-2-2-3-1\" data-name=\"checklist line icon\"></i>\n              Supported crops\n            </button>\n<button class=\"mt-[12px] flex h-[48px] w-full items-center justify-center text-[16px] text-[#F6E7DF] underline decoration-[#F6E7DF]/40 underline-offset-4\" data-kid=\"1-1-5-2-2-2-4\" data-name=\"secondary choose another photo link button\">\n              Choose another photo\n            </button>\n</div>\n<div class=\"mt-auto\" data-kid=\"1-1-5-2-2-3\" data-name=\"screen 5 footer actions container\">\n<div class=\"flex h-[56px] items-center justify-between border-t border-[#1C1410]/12\" data-kid=\"1-1-5-2-2-3-1\" data-name=\"review photo nav row\">\n<span class=\"flex items-center gap-[10px] text-[16px]\" data-kid=\"1-1-5-2-2-3-1-1\" data-name=\"review photo label with icon\">\n<i class=\"ri-image-line text-[22px] text-[#8A776C]\" data-kid=\"1-1-5-2-2-3-1-1-1\" data-name=\"image line icon\"></i>\n                Review photo\n              </span>\n<i class=\"ri-arrow-right-s-line text-[22px] text-[#8A776C]\" data-kid=\"1-1-5-2-2-3-1-2\" data-name=\"right arrow navigation icon\"></i>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>",
