      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&display=swap');\n  @import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n</style>\n<div class=\"min-h-screen bg-[#ECEBF1] px-10 py-10\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'Hanken Grotesk', ui-sans-serif, sans-serif;\">\n<!-- screen 1 : choose a photo -->\n<div class=\"w-[1360px]\" data-kid=\"1-1\" data-name=\"screenshot 1 wrapper (choose a photo screen)\">\n<p class=\"mb-3 text-[13px] font-medium text-[#191919]/50\" data-kid=\"1-1-1\" data-name=\"screenshot 1 label text\">Choose a photo</p>\n<section class=\"flex h-[860px] w-[1360px] flex-col overflow-hidden rounded-[24px] border border-[#191919]/10 bg-[#F5F4F9] shadow-[0_2px_28px_rgba(25,25,25,0.07)]\" data-kid=\"1-1-2\" data-name=\"choose photo screen card\">\n<!-- header -->\n<header class=\"flex h-[72px] shrink-0 items-center justify-between border-b border-[#191919]/8 px-6\" data-kid=\"1-1-2-1\" data-name=\"app header bar\">\n<div class=\"flex items-center gap-2.5\" data-kid=\"1-1-2-1-1\" data-name=\"brand logo group\">\n<i aria-hidden=\"true\" class=\"ti ti-leaf text-[24px] text-[#944BBB]\" data-kid=\"1-1-2-1-1-1\" data-name=\"leaf brand icon\"></i>\n<span class=\"text-[17px] font-semibold tracking-[-0.01em] text-[#191919]\" data-kid=\"1-1-2-1-1-2\" data-name=\"brand name text\">Plant Disease Detection</span>\n</div>\n<div class=\"flex h-10 items-center gap-2 rounded-full px-3 text-[14px] font-medium text-[#531CB3]\" data-kid=\"1-1-2-1-2\" data-name=\"supported crops nav pill\">\n<span data-kid=\"1-1-2-1-2-1\" data-name=\"supported crops label\">Supported crops</span>\n<i class=\"ti ti-chevron-right text-[16px]\" data-kid=\"1-1-2-1-2-2\" data-name=\"chevron right arrow icon\"></i>\n</div>\n</header>\n<div class=\"grid flex-1 grid-cols-2 gap-6 p-6\" data-kid=\"1-1-2-2\" data-name=\"main content two-column grid\">\n<!-- evidence / input region -->\n<div class=\"flex h-[740px] flex-col rounded-[28px] bg-white p-5\" data-kid=\"1-1-2-2-1\" data-name=\"photo upload panel\">\n<h1 class=\"text-[40px] font-semibold leading-[1.08] tracking-[-0.02em] text-[#191919]\" data-kid=\"1-1-2-2-1-1\" data-name=\"upload panel headline\">Choose a photo</h1>\n<div class=\"mt-6 flex flex-1 flex-col items-center justify-center rounded-[24px] border border-dashed border-[#191919]/20 bg-[#F5F4F9] px-8 text-center\" data-kid=\"1-1-2-2-1-2\" data-name=\"drag-and-drop photo upload zone\">\n<i class=\"ti ti-camera text-[40px] text-[#191919]/30\" data-kid=\"1-1-2-2-1-2-1\" data-name=\"camera icon placeholder\"></i>\n<p class=\"mt-4 text-[18px] leading-[26px] text-[#191919]/70\" data-kid=\"1-1-2-2-1-2-2\" data-name=\"upload instructional headline text\">One leaf, in focus, in daylight.</p>\n<p class=\"mt-2 text-[14px] leading-[22px] text-[#191919]/45\" data-kid=\"1-1-2-2-1-2-3\" data-name=\"drag-and-drop helper text\">Drag and drop a photo here.</p>\n</div>\n<div class=\"mt-4 flex h-14 items-center\" data-kid=\"1-1-2-2-1-3\" data-name=\"action button row\">\n<button class=\"flex h-14 items-center gap-2.5 rounded-full bg-[#944BBB] px-7 text-[17px] font-semibold text-[#F5F4F9]\" data-kid=\"1-1-2-2-1-3-1\" data-name=\"primary choose photo button (solo)\">\n<i class=\"ti ti-photo text-[20px]\" data-kid=\"1-1-2-2-1-3-1-1\" data-name=\"photo icon\"></i>\n              Choose photo\n            </button>\n</div>\n</div>\n<!-- reading region, empty -->\n<div class=\"flex h-[740px] flex-col rounded-[28px] bg-white p-5\" data-kid=\"1-1-2-2-2\" data-name=\"result panel (empty state)\">\n<h2 class=\"text-[20px] font-semibold tracking-[-0.01em] text-[#191919]\" data-kid=\"1-1-2-2-2-1\" data-name=\"result panel heading\">Result</h2>\n<div class=\"flex flex-1 flex-col items-center justify-center px-6 text-center\" data-kid=\"1-1-2-2-2-2\" data-name=\"empty result state container\">\n<i class=\"ti ti-photo text-[28px] text-[#191919]/20\" data-kid=\"1-1-2-2-2-2-1\" data-name=\"photo placeholder icon\"></i>\n<p class=\"mt-3 text-[18px] leading-[26px] text-[#191919]/55\" data-kid=\"1-1-2-2-2-2-2\" data-name=\"no photo yet message\">No photo yet</p>\n</div>\n<div class=\"flex h-14 items-center justify-between border-t border-[#191919]/10\" data-kid=\"1-1-2-2-2-3\" data-name=\"footer actions row\">\n<span class=\"text-[16px] font-medium text-[#191919]\" data-kid=\"1-1-2-2-2-3-1\" data-name=\"supported crops footer label\">Supported crops</span>\n<i class=\"ti ti-chevron-right text-[20px] text-[#191919]/40\" data-kid=\"1-1-2-2-2-3-2\" data-name=\"chevron right arrow icon\"></i>\n</div>\n</div>\n</div>\n</section>\n</div>\n<!-- screen 2 : result -->\n<div class=\"mt-10 w-[1360px]\" data-kid=\"1-2\" data-name=\"screenshot 2 wrapper (result screen)\">\n<p class=\"mb-3 text-[13px] font-medium text-[#191919]/50\" data-kid=\"1-2-1\" data-name=\"screenshot 2 label text\">Result</p>\n<section class=\"flex h-[860px] w-[1360px] flex-col overflow-hidden rounded-[24px] border border-[#191919]/10 bg-[#F5F4F9] shadow-[0_2px_28px_rgba(25,25,25,0.07)]\" data-kid=\"1-2-2\" data-name=\"result screen card\">\n<header class=\"flex h-[72px] shrink-0 items-center justify-between border-b border-[#191919]/8 px-6\" data-kid=\"1-2-2-1\" data-name=\"app header bar\">\n<div class=\"flex items-center gap-2.5\" data-kid=\"1-2-2-1-1\" data-name=\"brand logo group\">\n<i aria-hidden=\"true\" class=\"ti ti-leaf text-[24px] text-[#944BBB]\" data-kid=\"1-2-2-1-1-1\" data-name=\"leaf brand icon\"></i>\n<span class=\"text-[17px] font-semibold tracking-[-0.01em] text-[#191919]\" data-kid=\"1-2-2-1-1-2\" data-name=\"brand name text\">Plant Disease Detection</span>\n</div>\n<div class=\"flex h-10 items-center gap-2 rounded-full px-3 text-[14px] font-medium text-[#531CB3]\" data-kid=\"1-2-2-1-2\" data-name=\"supported crops nav pill\">\n<span data-kid=\"1-2-2-1-2-1\" data-name=\"supported crops label\">Supported crops</span>\n<i class=\"ti ti-chevron-right text-[16px]\" data-kid=\"1-2-2-1-2-2\" data-name=\"chevron right arrow icon\"></i>\n</div>\n</header>\n<div class=\"grid flex-1 grid-cols-2 gap-6 p-6\" data-kid=\"1-2-2-2\" data-name=\"main content two-column grid\">\n<!-- persistent photo -->\n<div class=\"flex h-[740px] flex-col rounded-[28px] bg-white p-5\" data-kid=\"1-2-2-2-1\" data-name=\"uploaded photo panel\">\n<div class=\"relative flex-1 overflow-hidden rounded-[20px] bg-[#EFEEF4]\" data-kid=\"1-2-2-2-1-1\" data-name=\"photo image container\">\n<img alt=\"Tomato leaf with brown spots (Nothing Ahead on Pexels)\" class=\"h-full w-full object-cover\" data-kid=\"1-2-2-2-1-1-1\" data-name=\"uploaded tomato leaf photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/7124505/pexels-photo-7124505.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=1200&amp;q=80\"/>\n<button class=\"absolute right-3 top-3 flex h-11 items-center gap-2 rounded-full bg-white/95 px-4 text-[14px] font-medium text-[#191919] shadow-[0_1px_8px_rgba(25,25,25,0.10)]\" data-kid=\"1-2-2-2-1-1-2\" data-name=\"photo enlarge button\">\n<i class=\"ti ti-zoom-in text-[18px]\" data-kid=\"1-2-2-2-1-1-2-1\" data-name=\"zoom in icon\"></i>\n              Enlarge\n            </button>\n</div>\n<div class=\"mt-4 flex h-14 items-center justify-between\" data-kid=\"1-2-2-2-1-2\" data-name=\"photo action buttons row\">\n<button class=\"flex items-center gap-2 text-[16px] font-medium text-[#191919]/80\" data-kid=\"1-2-2-2-1-2-1\" data-name=\"replace photo button\">\n<i class=\"ti ti-refresh text-[20px]\" data-kid=\"1-2-2-2-1-2-1-1\" data-name=\"refresh icon\"></i>\n              Replace photo\n            </button>\n<button class=\"flex items-center gap-2 text-[16px] font-medium text-[#531CB3]\" data-kid=\"1-2-2-2-1-2-2\" data-name=\"check another photo button\">\n              Check another photo\n              <i class=\"ti ti-arrow-right text-[18px]\" data-kid=\"1-2-2-2-1-2-2-1\" data-name=\"arrow right icon\"></i>\n</button>\n</div>\n</div>\n<!-- reading region, supported result -->\n<div class=\"flex h-[740px] flex-col rounded-[28px] bg-white p-5\" data-kid=\"1-2-2-2-2\" data-name=\"disease result panel\">\n<div class=\"flex h-11 shrink-0 items-center gap-2 rounded-[14px] bg-[#944BBB] px-4 text-[#F5F4F9]\" data-kid=\"1-2-2-2-2-1\" data-name=\"supported status badge\">\n<i class=\"ti ti-circle-check text-[18px]\" data-kid=\"1-2-2-2-2-1-1\" data-name=\"checkmark circle icon\"></i>\n<span class=\"text-[14px] font-semibold tracking-[0.01em]\" data-kid=\"1-2-2-2-2-1-2\" data-name=\"supported status label\">Supported</span>\n</div>\n<div class=\"mt-6\" data-kid=\"1-2-2-2-2-2\" data-name=\"detection result title block\">\n<h1 class=\"text-[40px] font-semibold leading-[1.06] tracking-[-0.02em] text-[#191919]\" data-kid=\"1-2-2-2-2-2-1\" data-name=\"detected crop name headline\">Tomato</h1>\n<p class=\"mt-1 text-[24px] font-medium leading-[32px] text-[#191919]/75\" data-kid=\"1-2-2-2-2-2-2\" data-name=\"detected disease name subtitle\">Early blight</p>\n</div>\n<div class=\"mt-8 flex h-14 shrink-0 items-stretch gap-8 border-b border-[#191919]/10\" data-kid=\"1-2-2-2-2-4\" data-name=\"result tab bar\">\n<span class=\"flex items-center border-b-2 border-[#944BBB] text-[16px] font-semibold text-[#191919]\" data-kid=\"1-2-2-2-2-4-1\" data-name=\"treatment active tab\">Treatment</span>\n<span class=\"flex items-center text-[16px] font-medium text-[#191919]/45\" data-kid=\"1-2-2-2-2-4-2\" data-name=\"symptoms inactive tab\">Symptoms</span>\n<span class=\"flex items-center text-[16px] font-medium text-[#191919]/45\" data-kid=\"1-2-2-2-2-4-3\" data-name=\"prevention inactive tab\">Prevention</span>\n</div>\n<ol class=\"mt-4 flex flex-col\" data-kid=\"1-2-2-2-2-5\" data-name=\"treatment steps list\">\n<li class=\"flex items-start gap-3 py-3.5\" data-kid=\"1-2-2-2-2-5-1\" data-name=\"treatment step item 1\">\n<span class=\"mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#F5F4F9] text-[13px] font-semibold text-[#191919]/70\" data-kid=\"1-2-2-2-2-5-1-1\" data-name=\"step number badge 1\">1</span>\n<span class=\"text-[18px] leading-[26px] text-[#191919]\" data-kid=\"1-2-2-2-2-5-1-2\" data-name=\"treatment step 1 text\">Apply fungicide containing chlorothalonil or mancozeb</span>\n</li>\n<li class=\"flex items-start gap-3 py-3.5\" data-kid=\"1-2-2-2-2-5-2\" data-name=\"treatment step item 2\">\n<span class=\"mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#F5F4F9] text-[13px] font-semibold text-[#191919]/70\" data-kid=\"1-2-2-2-2-5-2-1\" data-name=\"step number badge 2\">2</span>\n<span class=\"text-[18px] leading-[26px] text-[#191919]\" data-kid=\"1-2-2-2-2-5-2-2\" data-name=\"treatment step 2 text\">Remove infected leaves</span>\n</li>\n<li class=\"flex items-start gap-3 py-3.5\" data-kid=\"1-2-2-2-2-5-3\" data-name=\"treatment step item 3\">\n<span class=\"mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#F5F4F9] text-[13px] font-semibold text-[#191919]/70\" data-kid=\"1-2-2-2-2-5-3-1\" data-name=\"step number badge 3\">3</span>\n<span class=\"text-[18px] leading-[26px] text-[#191919]\" data-kid=\"1-2-2-2-2-5-3-2\" data-name=\"treatment step 3 text\">Improve air circulation</span>\n</li>\n</ol>\n<div class=\"mt-auto flex h-14 shrink-0 items-center justify-between border-t border-[#191919]/10\" data-kid=\"1-2-2-2-2-6\" data-name=\"result footer actions row\">\n<span class=\"text-[16px] font-medium text-[#191919]\" data-kid=\"1-2-2-2-2-6-1\" data-name=\"result details label\">Result details</span>\n<span class=\"flex items-center gap-2 text-[14px] text-[#191919]/50\" data-kid=\"1-2-2-2-2-6-2\" data-name=\"model confidence display\">\n              Model confidence 93%\n<i class=\"ti ti-chevron-down text-[18px]\" data-kid=\"1-2-2-2-2-6-2-1\" data-name=\"chevron down icon\"></i>\n</span>\n</div>\n</div>\n</div>\n</section>\n</div>\n<!-- screen 3 : could not identify -->\n<div class=\"mt-10 w-[1360px]\" data-kid=\"1-3\" data-name=\"screenshot 3 wrapper (could not identify screen)\">\n<p class=\"mb-3 text-[13px] font-medium text-[#191919]/50\" data-kid=\"1-3-1\" data-name=\"screenshot 3 label text\">Could not identify</p>\n<section class=\"flex h-[860px] w-[1360px] flex-col overflow-hidden rounded-[24px] border border-[#191919]/10 bg-[#F5F4F9] shadow-[0_2px_28px_rgba(25,25,25,0.07)]\" data-kid=\"1-3-2\" data-name=\"could not identify screen card\">\n<header class=\"flex h-[72px] shrink-0 items-center justify-between border-b border-[#191919]/8 px-6\" data-kid=\"1-3-2-1\" data-name=\"app header bar\">\n<div class=\"flex items-center gap-2.5\" data-kid=\"1-3-2-1-1\" data-name=\"brand logo group\">\n<i aria-hidden=\"true\" class=\"ti ti-leaf text-[24px] text-[#944BBB]\" data-kid=\"1-3-2-1-1-1\" data-name=\"leaf brand icon\"></i>\n<span class=\"text-[17px] font-semibold tracking-[-0.01em] text-[#191919]\" data-kid=\"1-3-2-1-1-2\" data-name=\"brand name text\">Plant Disease Detection</span>\n</div>\n<div class=\"flex h-10 items-center gap-2 rounded-full px-3 text-[14px] font-medium text-[#531CB3]\" data-kid=\"1-3-2-1-2\" data-name=\"supported crops nav pill\">\n<span data-kid=\"1-3-2-1-2-1\" data-name=\"supported crops label\">Supported crops</span>\n<i class=\"ti ti-chevron-right text-[16px]\" data-kid=\"1-3-2-1-2-2\" data-name=\"chevron right arrow icon\"></i>\n</div>\n</header>\n<div class=\"grid flex-1 grid-cols-2 gap-6 p-6\" data-kid=\"1-3-2-2\" data-name=\"main content two-column grid\">\n<div class=\"flex h-[740px] flex-col rounded-[28px] bg-white p-5\" data-kid=\"1-3-2-2-1\" data-name=\"uploaded photo panel\">\n<div class=\"relative flex-1 overflow-hidden rounded-[20px] bg-[#EFEEF4]\" data-kid=\"1-3-2-2-1-1\" data-name=\"photo image container\">\n<img alt=\"Out-of-focus green leaves (Shakib Uzzaman on Unsplash)\" class=\"h-full w-full object-cover\" data-kid=\"1-3-2-2-1-1-1\" data-name=\"submitted out-of-focus leaf photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1690553563186-ea46190f1465?auto=format&amp;w=1200&amp;q=80&amp;fit=crop\"/>\n<button class=\"absolute right-3 top-3 flex h-11 items-center gap-2 rounded-full bg-white/95 px-4 text-[14px] font-medium text-[#191919] shadow-[0_1px_8px_rgba(25,25,25,0.10)]\" data-kid=\"1-3-2-2-1-1-2\" data-name=\"photo enlarge button\">\n<i class=\"ti ti-zoom-in text-[18px]\" data-kid=\"1-3-2-2-1-1-2-1\" data-name=\"zoom in icon\"></i>\n              Enlarge\n            </button>\n</div>\n<div class=\"mt-4 flex h-14 items-center\" data-kid=\"1-3-2-2-1-2\" data-name=\"photo action buttons row (replace only)\">\n<button class=\"flex items-center gap-2 text-[16px] font-medium text-[#191919]/80\" data-kid=\"1-3-2-2-1-2-1\" data-name=\"replace photo button\">\n<i class=\"ti ti-refresh text-[20px]\" data-kid=\"1-3-2-2-1-2-1-1\" data-name=\"refresh icon\"></i>\n              Replace photo\n            </button>\n</div>\n</div>\n<div class=\"flex h-[740px] flex-col rounded-[28px] bg-[#8AB2CB] p-8\" data-kid=\"1-3-2-2-2\" data-name=\"uncertain outcome panel\">\n<div class=\"flex flex-1 flex-col justify-center\" data-kid=\"1-3-2-2-2-1\" data-name=\"uncertain outcome content\">\n<h2 class=\"max-w-[430px] text-[34px] font-semibold leading-[1.16] tracking-[-0.015em] text-[#191919]\" data-kid=\"1-3-2-2-2-1-1\" data-name=\"uncertain outcome headline\">Could not identify the disease.</h2>\n<p class=\"mt-5 max-w-[460px] text-[18px] leading-[26px] text-[#191919]/80\" data-kid=\"1-3-2-2-2-1-2\" data-name=\"uncertain outcome description\">Low confidence prediction. The model is uncertain about this classification. Please try a clearer image of the plant leaf.</p>\n<button class=\"mt-9 flex h-14 w-fit items-center gap-2.5 rounded-full bg-[#191919] px-7 text-[17px] font-semibold text-[#F5F4F9]\" data-kid=\"1-3-2-2-2-1-3\" data-name=\"replace photo primary button\">\n<i class=\"ti ti-refresh text-[20px]\" data-kid=\"1-3-2-2-2-1-3-1\" data-name=\"refresh icon\"></i>\n              Replace photo\n            </button>\n</div>\n<div class=\"mt-6 flex h-14 shrink-0 items-center justify-between border-t border-[#191919]/20\" data-kid=\"1-3-2-2-2-2\" data-name=\"result footer actions row\">\n<span class=\"text-[16px] font-medium text-[#191919]\" data-kid=\"1-3-2-2-2-2-1\" data-name=\"result details label\">Result details</span>\n<span class=\"flex items-center gap-2 text-[14px] text-[#191919]/60\" data-kid=\"1-3-2-2-2-2-2\" data-name=\"model confidence display\">\n              Model confidence 26%\n              <i class=\"ti ti-chevron-down text-[18px]\" data-kid=\"1-3-2-2-2-2-2-1\" data-name=\"chevron down icon\"></i>\n</span>\n</div>\n</div>\n</div>\n</section>\n</div>\n<!-- screen 4 : no supported result -->\n<div class=\"mt-10 w-[1360px]\" data-kid=\"1-4\" data-name=\"screenshot 4 wrapper (no supported result screen)\">\n<p class=\"mb-3 text-[13px] font-medium text-[#191919]/50\" data-kid=\"1-4-1\" data-name=\"screenshot 4 label text\">No supported result</p>\n<section class=\"flex h-[860px] w-[1360px] flex-col overflow-hidden rounded-[24px] border border-[#191919]/10 bg-[#F5F4F9] shadow-[0_2px_28px_rgba(25,25,25,0.07)]\" data-kid=\"1-4-2\" data-name=\"no supported result screen card\">\n<header class=\"flex h-[72px] shrink-0 items-center justify-between border-b border-[#191919]/8 px-6\" data-kid=\"1-4-2-1\" data-name=\"app header bar\">\n<div class=\"flex items-center gap-2.5\" data-kid=\"1-4-2-1-1\" data-name=\"brand logo group\">\n<i aria-hidden=\"true\" class=\"ti ti-leaf text-[24px] text-[#944BBB]\" data-kid=\"1-4-2-1-1-1\" data-name=\"leaf brand icon\"></i>\n<span class=\"text-[17px] font-semibold tracking-[-0.01em] text-[#191919]\" data-kid=\"1-4-2-1-1-2\" data-name=\"brand name text\">Plant Disease Detection</span>\n</div>\n<div class=\"flex h-10 items-center gap-2 rounded-full px-3 text-[14px] font-medium text-[#531CB3]\" data-kid=\"1-4-2-1-2\" data-name=\"supported crops nav pill\">\n<span data-kid=\"1-4-2-1-2-1\" data-name=\"supported crops label\">Supported crops</span>\n<i class=\"ti ti-chevron-right text-[16px]\" data-kid=\"1-4-2-1-2-2\" data-name=\"chevron right arrow icon\"></i>\n</div>\n</header>\n<div class=\"grid flex-1 grid-cols-2 gap-6 p-6\" data-kid=\"1-4-2-2\" data-name=\"main content two-column grid\">\n<div class=\"flex h-[740px] flex-col rounded-[28px] bg-white p-5\" data-kid=\"1-4-2-2-1\" data-name=\"uploaded photo panel\">\n<div class=\"relative flex-1 overflow-hidden rounded-[20px] bg-[#EFEEF4]\" data-kid=\"1-4-2-2-1-1\" data-name=\"photo image container\">\n<img alt=\"Out-of-focus green leaves (Shakib Uzzaman on Unsplash)\" class=\"h-full w-full object-cover\" data-kid=\"1-4-2-2-1-1-1\" data-name=\"submitted out-of-focus leaf photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1690553563186-ea46190f1465?auto=format&amp;w=1200&amp;q=80&amp;fit=crop\"/>\n<button class=\"absolute right-3 top-3 flex h-11 items-center gap-2 rounded-full bg-white/95 px-4 text-[14px] font-medium text-[#191919] shadow-[0_1px_8px_rgba(25,25,25,0.10)]\" data-kid=\"1-4-2-2-1-1-2\" data-name=\"photo enlarge button\">\n<i class=\"ti ti-zoom-in text-[18px]\" data-kid=\"1-4-2-2-1-1-2-1\" data-name=\"zoom in icon\"></i>\n              Enlarge\n            </button>\n</div>\n<div class=\"mt-4 flex h-14 items-center\" data-kid=\"1-4-2-2-1-2\" data-name=\"photo action buttons row (replace only)\">\n<button class=\"flex items-center gap-2 text-[16px] font-medium text-[#191919]/80\" data-kid=\"1-4-2-2-1-2-1\" data-name=\"replace photo button\">\n<i class=\"ti ti-refresh text-[20px]\" data-kid=\"1-4-2-2-1-2-1-1\" data-name=\"refresh icon\"></i>\n              Replace photo\n            </button>\n</div>\n</div>\n<div class=\"flex h-[740px] flex-col rounded-[28px] bg-white p-8\" data-kid=\"1-4-2-2-2\" data-name=\"unsupported outcome panel\">\n<div class=\"flex flex-1 flex-col justify-start pt-10\" data-kid=\"1-4-2-2-2-1\" data-name=\"unsupported outcome content\">\n<div class=\"flex h-11 w-fit items-center gap-2 rounded-[14px] bg-[#531CB3] px-4 text-[#F5F4F9]\" data-kid=\"1-4-2-2-2-1-1\" data-name=\"unsupported outcome badge\">\n<i class=\"ti ti-circle-x text-[18px]\" data-kid=\"1-4-2-2-2-1-1-1\" data-name=\"circle x icon\"></i>\n<span class=\"text-[14px] font-semibold tracking-[0.01em]\" data-kid=\"1-4-2-2-2-1-1-2\" data-name=\"unsupported outcome label\">No supported result</span>\n</div>\n<p class=\"mt-7 max-w-[440px] text-[18px] leading-[26px] text-[#191919]/75\" data-kid=\"1-4-2-2-2-1-2\" data-name=\"unsupported outcome description\">This photo did not return a supported crop or disease.</p>\n<div class=\"mt-9 flex items-center gap-6\" data-kid=\"1-4-2-2-2-1-3\" data-name=\"unsupported outcome actions\">\n<button class=\"flex h-14 items-center gap-2.5 rounded-full bg-[#531CB3] px-7 text-[17px] font-semibold text-[#F5F4F9]\" data-kid=\"1-4-2-2-2-1-3-1\" data-name=\"supported crops primary button\">\n<i class=\"ti ti-plant text-[20px]\" data-kid=\"1-4-2-2-2-1-3-1-1\" data-name=\"plant icon\"></i>\n                Supported crops\n              </button>\n<button class=\"flex items-center gap-2 text-[16px] font-medium text-[#191919]/80\" data-kid=\"1-4-2-2-2-1-3-2\" data-name=\"choose another photo text action\">\n<i class=\"ti ti-photo text-[20px]\" data-kid=\"1-4-2-2-2-1-3-2-1\" data-name=\"photo icon\"></i>\n                Choose another photo\n              </button>\n</div>\n</div>\n</div>\n</div>\n</section>\n</div>\n</div>",
